<!DOCTYPE html>
<html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>EGS FIRE ACADEMY</title><link rel="stylesheet" href="styles.css"></head><body>
<header class="topbar"><div><div class="brand">EGS FIRE ACADEMY</div><div class="subtitle">Centro de Investigación, Simulación y Entrenamiento Bomberil</div></div><div class="status" id="apiStatus">ALPHA 0.5 - CARGANDO</div></header>
<main>
<section id="home" class="screen active"><p class="eyebrow">ENTRENAMIENTO PROFESIONAL PARA BOMBEROS VOLUNTARIOS</p><h1>Centro de Simulación Virtual</h1><p class="lead">Entrenamiento doctrinario, toma de decisiones, trazabilidad de fuentes y debriefing.</p><div class="cards">
<article class="card" onclick="openModule('chemistry')"><span>01</span><h2>Química del Fuego</h2><p>Combustión, pirólisis, triángulo/tetraedro, fases y fenómenos.</p><button>INGRESAR</button></article>
<article class="card featured" onclick="openModule('operations')"><span>02</span><h2>Operaciones en Incendios Estructurales</h2><p>Emplazamiento, zonas, ventilación, lectura del incendio y decisiones.</p><button>ENTRENAR</button></article>
<article class="card" onclick="showSources()"><span>03</span><h2>Biblioteca doctrinaria</h2><p>Fuentes, organismo, versión y estado de revisión.</p><button>CONSULTAR</button></article>
</div></section>
<section id="chemistry" class="screen"><button class="back" onclick="goHome()">← Centro principal</button><p class="eyebrow">MÓDULO 01</p><h1>Química del Fuego</h1><div id="chemistrySections" class="grid"></div><button class="primary" onclick="startTraining('chemistry')">INICIAR EVALUACIÓN</button></section>
<section id="operations" class="screen"><button class="back" onclick="goHome()">← Centro principal</button><p class="eyebrow">MÓDULO 02</p><h1>Operaciones en Incendios Estructurales</h1><div id="operationSections" class="grid"></div><h2>Escenarios</h2><div id="scenarioGrid" class="cards compact"></div><button class="primary" onclick="startTraining('structural-fire')">INICIAR ENTRENAMIENTO DOCTRINARIO</button></section>
<section id="sources" class="screen"><button class="back" onclick="goHome()">← Centro principal</button><p class="eyebrow">TRAZABILIDAD</p><h1>Biblioteca doctrinaria</h1><div id="sourceList" class="grid"></div></section>
<section id="training" class="screen"><div class="trainingHead"><div><p class="eyebrow">ENTRENAMIENTO ACTIVO</p><h1 id="trainingTitle">Entrenamiento</h1></div><div class="scoreMini">PUNTAJE <strong id="liveScore">100</strong></div></div><div class="trainingLayout"><div class="scenarioPanel"><div class="telemetry"><div><span>TIEMPO</span><strong id="time">00:00</strong></div><div><span>DECISIÓN</span><strong id="stepCounter">1/1</strong></div><div><span>FUENTE</span><strong id="sourceBadge">—</strong></div></div><div class="sceneMock"><div class="smoke"></div><div class="structure"></div></div></div><aside class="decisionPanel"><span class="panelLabel">DECISIÓN / CONOCIMIENTO</span><h2 id="question">Cargando...</h2><div id="options"></div><div id="feedback"></div><button class="finish" onclick="finishTraining()">FINALIZAR</button></aside></div></section>
<section id="debriefing" class="screen"><p class="eyebrow">INFORME POST ENTRENAMIENTO</p><h1>Debriefing</h1><div class="finalScore"><strong id="finalScore">100</strong><span>/100</span></div><div id="decisionLog" class="report"></div><button class="primary" onclick="goHome()">VOLVER AL CENTRO</button></section>
</main><footer><div><strong>EGS | Estudio de Gestión de Sistemas</strong><span>Centro de Investigación, Simulación y Entrenamiento Bomberil</span></div><div class="credit"><span>Desarrollado por</span><strong>Téc. Ambiental Yamila Vocos</strong><span>San Francisco, Córdoba - Argentina</span></div><div class="right"><span>Alpha 0.5 - 2026</span><span>Doctrina versionada y sujeta a revisión</span></div></footer><script src="app.js"></script></body></html>
