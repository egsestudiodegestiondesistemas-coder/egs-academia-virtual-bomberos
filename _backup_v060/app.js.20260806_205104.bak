const API_URL="http://127.0.0.1:8001";
let cache={chemistry:null,operations:null,sources:null,scenarios:null};
let activeTraining=[],activeMeta=null,current=0,score=100,log=[],timer=null,seconds=0;
function showScreen(id){document.querySelectorAll(".screen").forEach(x=>x.classList.remove("active"));document.getElementById(id)?.classList.add("active")}
function goHome(){stopTimer();showScreen("home")}
async function api(path){const r=await fetch(API_URL+path);if(!r.ok)throw new Error("HTTP "+r.status);return r.json()}
function txt(v){return String(v??"")}
async function boot(){try{const st=await api("/");document.getElementById("apiStatus").textContent=`ALPHA 0.5 - ${st.status.toUpperCase()}`;cache.sources=await api("/sources");cache.chemistry=await api("/doctrine/chemistry");cache.operations=await api("/doctrine/structural-fire");cache.scenarios=await api("/scenarios");renderModules()}catch(e){document.getElementById("apiStatus").textContent="ALPHA 0.5 - BACKEND DESCONECTADO";console.warn(e)}}
function renderModules(){const c=document.getElementById("chemistrySections");if(c&&cache.chemistry)c.innerHTML=cache.chemistry.sections.map(s=>`<article class="tile"><strong>${txt(s.title)}</strong><p>${txt(s.summary||s.concepts?.join(" · "))}</p></article>`).join("");const o=document.getElementById("operationSections");if(o&&cache.operations)o.innerHTML=cache.operations.sections.map(s=>`<article class="tile"><strong>${txt(s.title)}</strong><p>${txt((s.concepts||[]).join(" · "))}</p></article>`).join("");const sg=document.getElementById("scenarioGrid");if(sg&&cache.scenarios)sg.innerHTML=cache.scenarios.scenarios.map(s=>`<article class="card"><span>${txt(s.status).toUpperCase()}</span><h2>${txt(s.name)}</h2><p>${txt(s.module)}</p></article>`).join("")}
async function openModule(name){if(!cache.chemistry||!cache.operations)await boot();showScreen(name)}
async function showSources(){if(!cache.sources)cache.sources=await api("/sources");document.getElementById("sourceList").innerHTML=cache.sources.sources.map(s=>`<article class="sourceCard"><strong>${txt(s.title)}</strong><p>${txt(s.organization)}</p><p>Estado: ${txt(s.status)}</p><p>Rol: ${txt(s.role)}</p></article>`).join("");showScreen("sources")}
async function startTraining(type){const path=type==="chemistry"?"/doctrine/chemistry/training":"/doctrine/structural-fire/training";const data=await api(path);activeTraining=data.training||[];activeMeta=data.metadata||{};current=0;score=100;log=[];seconds=0;document.getElementById("trainingTitle").textContent=activeMeta.module_name||"Entrenamiento";document.getElementById("liveScore").textContent=score;showScreen("training");renderStep();startTimer()}
function renderStep(){const step=activeTraining[current];if(!step){finishTraining();return}document.getElementById("question").textContent=step.question;document.getElementById("stepCounter").textContent=`${current+1}/${activeTraining.length}`;document.getElementById("sourceBadge").textContent=step.source_id||"—";document.getElementById("feedback").innerHTML="";document.getElementById("options").innerHTML=(step.options||[]).map((o,i)=>`<button class="optionBtn" data-i="${i}">${txt(o.text)}</button>`).join("");document.querySelectorAll(".optionBtn").forEach(b=>b.onclick=()=>choose(step.options[Number(b.dataset.i)]))}
function choose(opt){score=Math.max(0,Math.min(100,score+Number(opt.score||0)));document.getElementById("liveScore").textContent=score;const status=opt.status==="correct"?"Adecuada":opt.status==="critical_error"?"Error crítico":"Requiere revisión";const fb=opt.status==="correct"?"Respuesta coherente con la fuente cargada.":opt.status==="critical_error"?"Decisión marcada como error crítico en este entrenamiento.":"La decisión no coincide con la opción doctrinaria esperada.";log.push({n:current+1,text:opt.text,status,impact:Number(opt.score||0),source:activeTraining[current].source_id});document.getElementById("feedback").innerHTML=`<div class="feedbackBox"><strong>${status}</strong><br>${fb}</div>`;document.querySelectorAll(".optionBtn").forEach(b=>b.disabled=true);current++;setTimeout(renderStep,850)}
function startTimer(){stopTimer();timer=setInterval(()=>{seconds++;const m=String(Math.floor(seconds/60)).padStart(2,"0"),s=String(seconds%60).padStart(2,"0");document.getElementById("time").textContent=`${m}:${s}`},1000)}
function stopTimer(){if(timer){clearInterval(timer);timer=null}}
function finishTraining(){stopTimer();document.getElementById("finalScore").textContent=score;document.getElementById("decisionLog").innerHTML=log.length?log.map(x=>`<div class="entry"><strong>Decisión ${x.n}</strong><p>${txt(x.text)}</p><p>${txt(x.status)} · Impacto ${x.impact} · Fuente ${txt(x.source)}</p></div>`).join(""):"<p>Sin decisiones registradas.</p>";showScreen("debriefing")}
document.addEventListener("DOMContentLoaded",boot);
