const API_URL="http://127.0.0.1:8001";
let cache={chemistry:null,operations:null,sources:null,scenarios:null,academy:null};
let activeTraining=[],activeMeta=null,current=0,score=100,log=[],timer=null,seconds=0;
function showScreen(id){document.querySelectorAll(".screen").forEach(x=>x.classList.remove("active"));document.getElementById(id)?.classList.add("active")}
function goHome(){stopTimer();showScreen("home");updateCampus()}
async function api(path){const r=await fetch(API_URL+path);if(!r.ok)throw new Error("HTTP "+r.status);return r.json()}
function txt(v){return String(v??"")}
function getProgress(){try{return JSON.parse(localStorage.getItem("egs_bomberos_progress"))||{intentos:0,mejor_puntaje:null,evaluaciones_completadas:0}}catch(e){return {intentos:0,mejor_puntaje:null,evaluaciones_completadas:0}}}
function saveProgress(p){localStorage.setItem("egs_bomberos_progress",JSON.stringify(p));updateCampus()}
function updateCampus(){const p=getProgress();document.getElementById("moduleCount").textContent=cache.academy?.modules?.length||8;document.getElementById("completedCount").textContent=p.evaluaciones_completadas||0;document.getElementById("bestScore").textContent=p.mejor_puntaje==null?"—":p.mejor_puntaje;document.getElementById("attemptCount").textContent=p.intentos||0}
async function boot(){try{const s=await api("/");document.getElementById("apiStatus").textContent=`ALFA 0.6 · ${txt(s.status).toUpperCase()}`;[cache.sources,cache.chemistry,cache.operations,cache.scenarios,cache.academy]=await Promise.all([api("/sources"),api("/doctrine/chemistry"),api("/doctrine/structural-fire"),api("/scenarios"),api("/academy/modules")]);render();updateCampus()}catch(e){document.getElementById("apiStatus").textContent="ALFA 0.6 · SERVIDOR DESCONECTADO";console.warn(e)}}
function render(){const a=document.getElementById("academyGrid");if(a&&cache.academy)a.innerHTML=cache.academy.modules.map(m=>`<article class="tile"><span>${txt(m.area)}</span><h2>${txt(m.name)}</h2><p>${txt(m.description)}</p><span class="moduleStatus">${txt(m.status).toUpperCase()}</span></article>`).join("");const c=document.getElementById("chemistrySections");if(c&&cache.chemistry)c.innerHTML=cache.chemistry.sections.map(s=>`<article class="tile"><h2>${txt(s.title)}</h2><p>${txt(s.summary||s.concepts?.join(" · "))}</p></article>`).join("");const o=document.getElementById("operationSections");if(o&&cache.operations)o.innerHTML=cache.operations.sections.map(s=>`<article class="tile"><h2>${txt(s.title)}</h2><p>${txt((s.concepts||[]).join(" · "))}</p></article>`).join("");const sg=document.getElementById("scenarioGrid");if(sg&&cache.scenarios)sg.innerHTML=cache.scenarios.scenarios.map(s=>`<article class="card"><span>${txt(s.status).toUpperCase()}</span><h2>${txt(s.name)}</h2><p>${txt(s.module)}</p></article>`).join("")}
async function openModule(name){if(!cache.academy)await boot();render();showScreen(name)}
async function showSources(){if(!cache.sources)cache.sources=await api("/sources");document.getElementById("sourceList").innerHTML=cache.sources.sources.map(s=>`<article class="sourceCard"><strong>${txt(s.title)}</strong><p>${txt(s.organization)}</p><p>Estado: ${txt(s.status)}</p><p>Rol: ${txt(s.role)}</p></article>`).join("");showScreen("sources")}
async function startTraining(type){const d=await api(type==="chemistry"?"/doctrine/chemistry/training":"/doctrine/structural-fire/training");activeTraining=d.training||[];activeMeta=d.metadata||{};current=0;score=100;log=[];seconds=0;const p=getProgress();p.intentos=(p.intentos||0)+1;saveProgress(p);document.getElementById("trainingTitle").textContent=activeMeta.module_name||"Entrenamiento";document.getElementById("liveScore").textContent=score;showScreen("training");renderStep();startTimer()}
function renderStep(){const s=activeTraining[current];if(!s){finishTraining();return}document.getElementById("question").textContent=s.question;document.getElementById("stepCounter").textContent=`${current+1}/${activeTraining.length}`;document.getElementById("sourceBadge").textContent=s.source_id||"—";document.getElementById("feedback").innerHTML="";document.getElementById("options").innerHTML=(s.options||[]).map((o,i)=>`<button class="optionBtn" data-i="${i}">${txt(o.text)}</button>`).join("");document.querySelectorAll(".optionBtn").forEach(b=>b.onclick=()=>choose(s.options[Number(b.dataset.i)]))}
function choose(o){score=Math.max(0,Math.min(100,score+Number(o.score||0)));document.getElementById("liveScore").textContent=score;const st=o.status==="correct"?"Adecuada":o.status==="critical_error"?"Error crítico":"Requiere revisión";log.push({n:current+1,text:o.text,status:st,impact:Number(o.score||0),source:activeTraining[current].source_id});document.getElementById("feedback").innerHTML=`<div class="feedbackBox"><strong>${st}</strong><br>${o.status==="correct"?"Respuesta coherente con la fuente cargada.":"Revisar el fundamento doctrinario en el análisis posterior."}</div>`;document.querySelectorAll(".optionBtn").forEach(b=>b.disabled=true);current++;setTimeout(renderStep,850)}
function startTimer(){stopTimer();timer=setInterval(()=>{seconds++;document.getElementById("time").textContent=`${String(Math.floor(seconds/60)).padStart(2,"0")}:${String(seconds%60).padStart(2,"0")}`},1000)}
function stopTimer(){if(timer){clearInterval(timer);timer=null}}
function finishTraining(){stopTimer();document.getElementById("finalScore").textContent=score;const p=getProgress();p.evaluaciones_completadas=(p.evaluaciones_completadas||0)+1;p.mejor_puntaje=p.mejor_puntaje==null?score:Math.max(p.mejor_puntaje,score);p.ultimo_puntaje=score;saveProgress(p);document.getElementById("decisionLog").innerHTML=log.length?log.map(x=>`<div class="entry"><strong>Decisión ${x.n}</strong><p>${txt(x.text)}</p><p>${txt(x.status)} · Impacto ${x.impact} · Fuente ${txt(x.source)}</p></div>`).join(""):"<p>Sin decisiones registradas.</p>";showScreen("analysis")}
document.addEventListener("DOMContentLoaded",boot);