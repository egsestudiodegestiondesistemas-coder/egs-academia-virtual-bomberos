*{box-sizing:border-box}body{margin:0;background:#080a0d;color:#f3f5f7;font-family:Arial,Helvetica,sans-serif}.topbar{min-height:84px;padding:18px 5vw;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #252a31;background:#0d1014}.brand{font-weight:800;letter-spacing:2px;font-size:21px}.subtitle{color:#8d959e;font-size:12px;margin-top:6px}.status,.eyebrow,.card>span,.panelLabel{color:#f26b38;letter-spacing:2px;font-size:11px}.screen{display:none;padding:55px 7vw 80px}.screen.active{display:block}h1{font-size:clamp(42px,6vw,76px);line-height:1;margin:12px 0 22px}.lead{color:#aeb5bd;font-size:17px;max-width:760px;line-height:1.7}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#292f36;margin:34px 0}.stats div{background:#101419;padding:18px}.stats span{display:block;color:#8d959e;font-size:10px;letter-spacing:1.4px}.stats strong{display:block;font-size:28px;margin-top:6px}.cards,.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:18px;margin:38px 0}.card,.tile,.sourceCard{background:#101419;border:1px solid #292f36;padding:27px}.card{cursor:pointer;transition:.2s}.card:hover{transform:translateY(-3px);border-color:#f26b38}.card h2,.tile h2{font-size:24px}.card p,.tile p,.sourceCard p{color:#9ca5ae;line-height:1.55}.featured{background:linear-gradient(135deg,rgba(242,107,56,.14),#101419 58%)}button{border:0;cursor:pointer;font-weight:800;letter-spacing:.8px}.card button,.primary{background:#f26b38;color:#0a0d10;padding:14px 18px}.back,.finish{background:transparent;color:#aeb5bd;padding:10px 0}.moduleStatus{display:inline-block;color:#f26b38;font-size:10px;letter-spacing:1px}.trainingHead{display:flex;justify-content:space-between;align-items:end}.scoreMini{text-align:right;color:#8d959e;font-size:11px}.scoreMini strong{display:block;color:white;font-size:38px}.trainingLayout{display:grid;grid-template-columns:1.6fr 1fr;gap:20px}.scenarioPanel,.decisionPanel{background:#101419;border:1px solid #292f36}.telemetry{display:grid;grid-template-columns:repeat(3,1fr)}.telemetry div{padding:18px;border-right:1px solid #292f36}.telemetry span{display:block;color:#8d959e;font-size:10px}.sceneMock{height:390px;position:relative;overflow:hidden;background:linear-gradient(#1b2026,#0c0f12)}.structure{position:absolute;width:64%;height:48%;left:18%;bottom:0;background:#30363d;border:2px solid #464e57}.smoke{position:absolute;inset:0 0 45% 0;background:linear-gradient(rgba(28,31,35,.8),transparent)}.decisionPanel{padding:30px}.optionBtn{display:block;width:100%;text-align:left;background:#181d23;color:white;border:1px solid #303740;padding:16px;margin:10px 0}.optionBtn:hover{border-color:#f26b38}.optionBtn:disabled{opacity:.5}.feedbackBox{margin-top:20px;padding:16px;background:#0c1014;border-left:3px solid #f26b38;color:#cbd1d7}.report{max-width:950px;background:#101419;border:1px solid #292f36;padding:28px;margin:30px 0}.entry{padding:18px 0;border-bottom:1px solid #292f36}.finalScore strong{font-size:90px}.finalScore span{font-size:28px;color:#8d959e}footer{display:grid;grid-template-columns:1fr 1fr 1fr;gap:25px;padding:22px 5vw;border-top:1px solid #23282e;background:#0b0e11;color:#69727c;font-size:10px}footer>div{display:flex;flex-direction:column;gap:5px}footer strong{color:#c8cdd2}.credit{text-align:center;align-items:center}.right{text-align:right;align-items:flex-end}@media(max-width:900px){.stats{grid-template-columns:1fr 1fr}.trainingLayout{grid-template-columns:1fr}.trainingHead{align-items:flex-start;flex-direction:column}footer{grid-template-columns:1fr}.credit,.right{text-align:left;align-items:flex-start}}