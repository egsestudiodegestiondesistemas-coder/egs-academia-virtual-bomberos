{
  "metadata": {
    "module_id": "LIN-001",
    "module_name": "Sistemas de Líneas, Mangas y Lanzas",
    "version": "0.7.0-alpha",
    "source_ids": [
      "SRC-LINEAS-BN1-SF-2026",
      "SRC-DC-BN1-2022"
    ],
    "status": "activo"
  },
  "sections": [
    {
      "title": "Lanzas",
      "summary": "Dispositivo ubicado en el extremo de la línea de ataque para controlar y dirigir el agente extintor y adaptar el chorro al objetivo."
    },
    {
      "title": "Tipos de lanzas",
      "summary": "El material BN1 incluye chorro pleno, combinada, alta presión, corte y caudal variable, monitores y lanza de espuma."
    },
    {
      "title": "Chorros",
      "summary": "Pleno para alcance y ataque directo; ataque para enfriamiento; protección para formar una cortina que reduzca radiación térmica."
    },
    {
      "title": "Mangas",
      "summary": "El material diferencia colapsables, semirrígidas y rígidas, con usos de ataque, primer ataque y succión/abastecimiento."
    },
    {
      "title": "Acondicionamiento",
      "summary": "Carretel, caracol simple/doble, estiba y Cleveland son formas de acondicionar y desplegar las mangas."
    },
    {
      "title": "Accesorios",
      "summary": "Reductor para unir diámetros diferentes; bifurcador para dividir una línea principal; dosificador para incorporar espumígeno."
    },
    {
      "title": "Uniones",
      "summary": "Whitworth, Gost y Storz. Storz es un acople rápido y simétrico y debe coincidir en diámetro."
    },
    {
      "title": "Sistema simple",
      "summary": "Una sola línea de mangas de igual diámetro, sin derivaciones, alimenta una única lanza."
    },
    {
      "title": "Sistema combinado",
      "summary": "Combina dos diámetros diferentes usando un reductor para pasar de mayor a menor diámetro."
    },
    {
      "title": "Sistema mixto",
      "summary": "Una línea principal alimenta dos o más líneas secundarias mediante un bifurcador."
    }
  ],
