{
  "metadata": {
    "module_id": "SOC-001",
    "module_name": "Socorrismo y Primeros Auxilios",
    "version": "0.7.0-alpha",
    "source_ids": [
      "SRC-SOC-BN1-2024",
      "SRC-DC-BN1-2022"
    ],
    "status": "activo"
  },
  "sections": [
    {
      "title": "Primeros auxilios",
      "summary": "Medidas inmediatas en una persona lesionada, inconsciente o súbitamente enferma en el lugar del incidente hasta la llegada de asistencia sanitaria."
    },
    {
      "title": "Objetivo",
      "summary": "Conservar la vida, evitar complicaciones y favorecer la recuperación actuando de la mejor manera posible."
    },
    {
      "title": "Socorrista o auxiliador",
      "summary": "Persona con formación adecuada que debe priorizar su autocuidado y solo asistir cuando su propia integridad no corre riesgo."
    },
    {
      "title": "Seguridad",
      "summary": "Procedimientos destinados a prevenir nuevos accidentes y proteger al equipo y a la víctima."
    },
    {
      "title": "Bioseguridad",
      "summary": "Medidas preventivas para controlar riesgos biológicos, físicos y químicos durante la asistencia."
    },
    {
      "title": "EPP",
      "summary": "El material diferencia protección mecánica y biológica, incluyendo casco, chaquetón, pantalón, botas, guantes, barbijo y protector facial."
    },
    {
      "title": "Equipamiento",
      "summary": "Incluye maletín de trauma, curaciones, vía aérea y paro, con elementos de inmovilización, oxígeno, bolsa-válvula-máscara y DEA."
    },
    {
      "title": "Contenidos BN1",
      "summary": "El diseño curricular incluye primeros auxilios, RCP, DEA, parámetros vitales, trauma, hemorragias, quemaduras, shock e inmovilización."
    }
  ],
