from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from pathlib import Path
import json

app = FastAPI(title="EGS | ACADEMIA VIRTUAL DE BOMBEROS API", version="0.7.0-alpha")
app.add_middleware(CORSMiddleware, allow_origins=["*"], allow_credentials=True, allow_methods=["*"], allow_headers=["*"])

BASE_DIR = Path(__file__).resolve().parent.parent
KNOWLEDGE_DIR = BASE_DIR / "knowledge"
SCENARIO_DIR = BASE_DIR / "scenarios"
MODULE_DIR = KNOWLEDGE_DIR / "modules"

def load_json(path: Path):
    if not path.exists():
        raise HTTPException(status_code=404, detail=f"No existe: {path.name}")
    return json.loads(path.read_text(encoding="utf-8"))

@app.get("/")
def root():
    return {"system":"EGS | ACADEMIA VIRTUAL DE BOMBEROS","status":"en línea","version":"0.7.0-alpha",
            "developer":"Téc. Ambiental Yamila Vocos","location":"San Francisco, Córdoba, Argentina"}

@app.get("/academy/modules")
def academy_modules():
    return load_json(KNOWLEDGE_DIR / "academy_modules.json")

@app.get("/academy/module/{module_id}")
def academy_module(module_id: str):
    mapping = {
        "quimica":"chemistry_training.json",
        "estructurales":"structural_fire_training.json"
    }
    if module_id in mapping:
        return load_json(KNOWLEDGE_DIR / mapping[module_id])
    return load_json(MODULE_DIR / f"{module_id}.json")

@app.get("/academy/module/{module_id}/training")
def academy_module_training(module_id: str):
    data = academy_module(module_id)
    return {"metadata":data.get("metadata",{}),"training":data.get("training",[])}

@app.get("/sources")
def source_registry():
    return load_json(KNOWLEDGE_DIR / "source_registry.json")

@app.get("/scenarios")
def scenario_registry():
    return load_json(SCENARIO_DIR / "scenario_registry.json")
