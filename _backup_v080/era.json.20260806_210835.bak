      "title": "Marco BN1",
      "summary": "El diseño curricular incluye equipos de respiración autónoma dentro de la protección personal del bombero."
    },
    {
      "title": "Competencias",
      "summary": "Se deben trabajar tipos, colocación, carga, inspección y uso del ERA."
    },
    {
      "title": "Alistamiento y cuidado",
      "summary": "El currículo también contempla uso, alistamiento y cuidado del equipo de protección respiratoria y su mantenimiento."
    },
    {
      "title": "Profundización",
      "summary": "Los modelos específicos del cuartel deben documentarse con sus manuales y procedimientos propios antes de cargar parámetros técnicos detallados."
    }
  ],
