  "sections": [
    {
      "title": "Evaluación de escena",
      "summary": "Identificar riesgos, vehículos, víctimas, tránsito, energías, fugas, tecnología y condiciones del entorno antes de iniciar maniobras.",
      "source_id": "SRC-RV-N1"
    },
    {
      "title": "Estabilización",
      "summary": "Evitar movimientos no deseados del vehículo y crear un espacio seguro de trabajo.",
      "source_id": "SRC-RV-N1"
    },
    {
      "title": "Acceso",
      "summary": "Generar un acceso controlado para valoración y asistencia de la víctima.",
      "source_id": "SRC-RV-N1"
    },
    {
      "title": "Herramientas",
      "summary": "Herramientas manuales e hidráulicas se seleccionan según objetivo, estructura y plan de rescate.",
      "source_id": "SRC-RV-N1"
    },
    {
      "title": "Extricación y extracción",
      "summary": "Extricación refiere a la liberación técnica; extracción, al retiro final de la víctima.",
      "source_id": "SRC-RV-N1"
    }
  ],
