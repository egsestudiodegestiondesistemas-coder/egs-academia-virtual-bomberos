*{box-sizing:border-box}body{margin:0;background:#080a0d;color:#f3f5f7;font-family:Arial,Helvetica,sans-serif}.topbar{min-height:84px;padding:16px 5vw;display:flex;gap:28px;justify-content:space-between;align-items:center;border-bottom:1px solid #252a31;background:#0d1014;position:sticky;top:0;z-index:20}.brand{font-weight:800;letter-spacing:2px;font-size:20px}.subtitle{color:#8d959e;font-size:12px;margin-top:6px}.status,.eyebrow,.panelLabel{color:#f26b38;letter-spacing:2px;font-size:11px}.topnav{display:flex;gap:8px}.topnav button{background:transparent;color:#aeb5bd;border:0;padding:10px}.topnav button:hover{color:#fff}.screen{display:none;padding:52px 7vw 78px}.screen.active{display:block}h1{font-size:clamp(42px,6vw,74px);line-height:1;margin:12px 0 22px}.lead{color:#aeb5bd;font-size:17px;max-width:780px;line-height:1.7}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#292f36;margin:32px 0}.stats div{background:#101419;padding:18px}.stats span{display:block;color:#8d959e;font-size:10px;letter-spacing:1.4px}.stats strong{display:block;font-size:28px;margin-top:6px}.heroActions{display:flex;gap:12px;flex-wrap:wrap;margin:26px 0}.searchBox input{width:100%;padding:16px;background:#101419;border:1px solid #292f36;color:white;font-size:16px}.cards,.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:18px;margin:36px 0}.tile,.sourceCard,.scenarioCard{background:#101419;border:1px solid #292f36;padding:26px;transition:.2s}.tile.clickable,.scenarioCard{cursor:pointer}.tile.clickable:hover,.scenarioCard:hover{border-color:#f26b38;transform:translateY(-2px)}.tile p,.sourceCard p,.scenarioCard p{color:#9ca5ae;line-height:1.55}.moduleStatus{display:inline-block;margin-top:10px;color:#f26b38;font-size:10px;letter-spacing:1px}.moduleBar{display:flex;gap:18px;color:#8d959e;font-size:12px;margin:10px 0 25px}.primary,.secondary{padding:14px 18px;font-weight:800;letter-spacing:.7px;cursor:pointer}.primary{background:#f26b38;color:#0a0d10;border:0}.secondary{background:#181d23;color:white;border:1px solid #303740}.back,.finish{background:transparent;color:#aeb5bd;border:0;padding:10px 0;cursor:pointer}.trainingHead{display:flex;justify-content:space-between;align-items:end}.scoreMini{text-align:right;color:#8d959e;font-size:11px}.scoreMini strong{display:block;color:white;font-size:38px}.trainingLayout{display:grid;grid-template-columns:1.6fr 1fr;gap:20px}.scenarioPanel,.decisionPanel{background:#101419;border:1px solid #292f36}.telemetry{display:grid;grid-template-columns:repeat(3,1fr)}.telemetry div{padding:18px;border-right:1px solid #292f36}.telemetry span{display:block;color:#8d959e;font-size:10px}.sceneMock{height:360px;position:relative;overflow:hidden;background:linear-gradient(#1b2026,#0c0f12)}.structure{position:absolute;width:64%;height:48%;left:18%;bottom:0;background:#30363d;border:2px solid #464e57}.smoke{position:absolute;inset:0 0 45% 0;background:linear-gradient(rgba(28,31,35,.8),transparent)}.decisionPanel{padding:30px}.optionBtn{display:block;width:100%;text-align:left;background:#181d23;color:white;border:1px solid #303740;padding:16px;margin:10px 0;cursor:pointer}.optionBtn:hover{border-color:#f26b38}.optionBtn:disabled{opacity:.5}.feedbackBox{margin-top:20px;padding:16px;background:#0c1014;border-left:3px solid #f26b38;color:#cbd1d7;line-height:1.5}.report{max-width:1000px;background:#101419;border:1px solid #292f36;padding:28px;margin:30px 0}.entry{padding:18px 0;border-bottom:1px solid #292f36}.entry:last-child{border-bottom:0}.analysisTop{display:flex;gap:40px;align-items:center}.finalScore strong{font-size:90px}.finalScore span{font-size:28px;color:#8d959e}footer{display:grid;grid-template-columns:1fr 1fr 1fr;gap:25px;padding:22px 5vw;border-top:1px solid #23282e;background:#0b0e11;color:#69727c;font-size:10px}footer>div{display:flex;flex-direction:column;gap:5px}footer strong{color:#c8cdd2}.credit{text-align:center;align-items:center}.credit strong{color:white}.right{text-align:right;align-items:flex-end}@media(max-width:1000px){.topnav{display:none}.stats{grid-template-columns:1fr 1fr}.trainingLayout{grid-template-columns:1fr}.trainingHead{align-items:flex-start;flex-direction:column}footer{grid-template-columns:1fr}.credit,.right{text-align:left;align-items:flex-start}}