  "sections": [
    {
      "title": "Línea simple",
      "summary": "Una sola línea de mangas de igual diámetro, sin derivaciones, alimenta una única lanza.",
      "source_id": "SRC-LINEAS-BN1-SF-2026"
    },
    {
      "title": "Línea combinada",
      "summary": "Combina dos diámetros diferentes mediante reductor para pasar de mayor a menor diámetro.",
      "source_id": "SRC-LINEAS-BN1-SF-2026"
    },
    {
      "title": "Línea mixta",
      "summary": "Una línea principal alimenta dos o más líneas secundarias mediante bifurcador.",
      "source_id": "SRC-LINEAS-BN1-SF-2026"
    },
    {
      "title": "Mangas",
      "summary": "Colapsables, semirrígidas y rígidas según uso y configuración operativa.",
      "source_id": "SRC-LINEAS-BN1-SF-2026"
    },
    {
      "title": "Plegados",
      "summary": "Carretel, caracol, estiba y Cleveland son formas de acondicionamiento y despliegue.",
      "source_id": "SRC-LINEAS-BN1-SF-2026"
    },
    {
      "title": "Accesorios",
      "summary": "Reductores, bifurcadores, dosificadores y uniones cumplen funciones específicas en la conducción y aplicación del agente.",
      "source_id": "SRC-LINEAS-BN1-SF-2026"
    }
  ],
