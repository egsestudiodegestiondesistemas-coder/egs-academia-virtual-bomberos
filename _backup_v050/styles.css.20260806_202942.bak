* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    background: #080a0d;
    color: #f1f3f5;
    font-family: Arial, Helvetica, sans-serif;
}

button {
    font-family: inherit;
}

.topbar {
    min-height: 88px;
    border-bottom: 1px solid #252a31;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 50px;
    background: #0d1014;
    position: sticky;
    top: 0;
    z-index: 100;
}

.brand {
    font-size: 24px;
    font-weight: 800;
    letter-spacing: 4px;
}

.subtitle {
    margin-top: 6px;
    color: #8d959e;
    font-size: 12px;
}

.status {
    font-size: 11px;
    letter-spacing: 2px;
    color: #f26b38;
    text-align: right;
}

main {
    min-height: calc(100vh - 170px);
}

.screen {
    display: none;
    padding: 55px 7vw 80px;
}

.screen.active {
    display: block;
}

.hero {
    max-width: 900px;
    margin-bottom: 60px;
}

.eyebrow {
    color: #f26b38;
    letter-spacing: 3px;
    font-size: 11px;
    font-weight: bold;
}

h1 {
    font-size: clamp(42px, 6vw, 82px);
    max-width: 1100px;
    margin: 10px 0 20px;
    line-height: 0.98;
}

.heroText,
.sectionIntro {
    max-width: 760px;
    color: #aeb5bd;
    line-height: 1.7;
    font-size: 17px;
}

.modules,
.scenarioGrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 22px;
}

.moduleCard,
.scenario {
    border: 1px solid #292f36;
    background: #101419;
    transition: .25s ease;
    cursor: pointer;
}

.moduleCard {
    padding: 35px;
    min-height: 300px;
}

.moduleCard:hover,
.scenario:hover {
    transform: translateY(-4px);
    border-color: #f26b38;
}

.featured {
    background:
        linear-gradient(
            135deg,
            rgba(242, 107, 56, .14),
            #101419 55%
        );
}

.number,
.scenarioBody span,
.panel span,
.panelLabel {
    color: #f26b38;
    font-size: 11px;
    letter-spacing: 2px;
}

.moduleCard h2 {
    margin-top: 50px;
    font-size: 28px;
}

.moduleCard p {
    color: #9ca5ae;
    min-height: 75px;
    line-height: 1.6;
}

button {
    border: none;
    cursor: pointer;
    font-weight: bold;
}

.moduleCard button,
.primary {
    background: #f26b38;
    color: #0b0d10;
    padding: 15px 20px;
    letter-spacing: 1px;
}

.back {
    background: transparent;
    color: #aeb5bd;
    padding: 10px 0;
    margin-bottom: 30px;
}

.trainingGrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 15px;
    margin-top: 50px;
}

.panel {
    background: #101419;
    border: 1px solid #292f36;
    min-height: 150px;
    padding: 25px;
}

.panel h3 {
    margin-top: 35px;
    font-size: 20px;
}

.scenarioGrid {
    margin-top: 45px;
}

.scenarioImage {
    height: 200px;
    background:
        radial-gradient(
            circle at 50% 80%,
            #343a40,
            #11151a
        );
}

.house {
    background:
        linear-gradient(
            180deg,
            #282d33,
            #0f1216
        );
}

.warehouse,
.building {
    opacity: .45;
}

.scenarioBody {
    padding: 25px;
}

.scenarioBody h3 {
    font-size: 22px;
}

.scenarioBody p {
    color: #9ba4ad;
    line-height: 1.5;
}

.disabled {
    opacity: .45;
    cursor: default;
}

.disabled:hover {
    transform: none;
    border-color: #292f36;
}

.simulationHeader {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 30px;
}

.simulationHeader h1 {
    font-size: 45px;
}

.timer {
    text-align: right;
}

.timer span,
.sceneInfo span {
    display: block;
    color: #89929c;
    font-size: 10px;
    letter-spacing: 2px;
}

.timer strong {
    font-size: 32px;
}

.simLayout {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 20px;
}

.scene {
    background: #15191e;
    border: 1px solid #2c323a;
    min-height: 560px;
    position: relative;
    overflow: hidden;
}

.buildingVisual {
    position: absolute;
    width: 70%;
    height: 55%;
    left: 15%;
    bottom: 80px;
    background: #252b31;
    border: 3px solid #383f47;
}

.window {
    position: absolute;
    width: 110px;
    height: 100px;
    top: 70px;
    background: #080a0c;
    border: 8px solid #15191d;
}

.window:nth-child(1) {
    left: 15%;
}

.window:nth-child(2) {
    right: 15%;
}

.door {
    position: absolute;
    width: 90px;
    height: 160px;
    bottom: 0;
    left: calc(50% - 45px);
    background: #111519;
}

.fire {
    font-size: 65px;
    text-align: center;
    padding-top: 15px;
}

.smoke {
    position: absolute;
    width: 100%;
    height: 50%;
    top: 0;
    background:
        linear-gradient(
            rgba(25, 28, 32, .8),
            transparent
        );
    transition: 1s;
}

.sceneInfo {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: rgba(5, 7, 9, .95);
}

.sceneInfo div {
    padding: 17px;
    border-right: 1px solid #292f36;
}

.sceneInfo strong {
    display: block;
    margin-top: 6px;
}

.decisionPanel {
    background: #101419;
    border: 1px solid #292f36;
    padding: 30px;
}

.decisionPanel h2 {
    font-size: 23px;
    line-height: 1.35;
    margin: 25px 0 30px;
}

.decision {
    width: 100%;
    padding: 17px;
    margin-bottom: 12px;
    text-align: left;
    background: #181d23;
    color: white;
    border: 1px solid #303740;
    transition: .2s;
}

.decision:hover:not(:disabled) {
    border-color: #f26b38;
    background: #20262d;
}

.decision:disabled {
    opacity: .55;
    cursor: default;
}

#feedback {
    margin: 25px 0;
    color: #d9dee3;
    line-height: 1.6;
    min-height: 70px;
}

#feedback strong {
    color: #f26b38;
}

.finish {
    margin-top: 30px;
    background: transparent;
    color: #9ba4ad;
}

.score {
    margin: 50px 0;
}

.score span {
    display: block;
    color: #8e979f;
}

.score strong {
    font-size: 90px;
}

.score small {
    font-size: 30px;
}

.report {
    background: #101419;
    border: 1px solid #292f36;
    padding: 30px;
    margin-bottom: 30px;
    max-width: 950px;
}

.debriefEntry {
    padding: 20px 0;
    border-bottom: 1px solid #292f36;
}

.debriefEntry:last-child {
    border-bottom: none;
}

.debriefEntry p {
    color: #c3c9cf;
    line-height: 1.5;
}

.debriefEntry small {
    color: #8d959e;
}

footer {
    min-height: 96px;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    align-items: center;
    gap: 30px;
    border-top: 1px solid #23282e;
    padding: 20px 50px;
    color: #69727c;
    font-size: 10px;
    background: #0b0e11;
}

footer > div {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

footer strong {
    color: #c8cdd2;
    font-size: 11px;
    letter-spacing: .5px;
}

.developer-credit {
    text-align: center;
    align-items: center;
}

.developer-credit strong {
    color: #f1f3f5;
    font-size: 12px;
}

.footer-right {
    text-align: right;
    align-items: flex-end;
}

@media (max-width: 900px) {

    .simLayout {
        grid-template-columns: 1fr;
    }

    .simulationHeader {
        align-items: flex-start;
        flex-direction: column;
    }

    .timer {
        text-align: left;
    }

    .topbar {
        position: static;
    }

    .topbar,
    footer {
        padding-left: 20px;
        padding-right: 20px;
    }

    .status {
        display: none;
    }

    footer {
        grid-template-columns: 1fr;
        text-align: left;
    }

    .developer-credit,
    .footer-right {
        text-align: left;
        align-items: flex-start;
    }

    .sceneInfo {
        grid-template-columns: repeat(2, 1fr);
    }
}