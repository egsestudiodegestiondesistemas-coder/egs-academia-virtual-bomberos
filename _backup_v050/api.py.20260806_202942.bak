from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
from pathlib import Path
import json

from backend.scenario_manager import ScenarioManager
from backend.fire_physics_engine import FirePhysicsEngine
from backend.decision_engine import DecisionEngine


app = FastAPI(
    title="EGS FIRE ACADEMY API",
    version="0.3.0"
)


app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)


BASE_DIR = Path(__file__).resolve().parent.parent
KNOWLEDGE_DIR = BASE_DIR / "knowledge"


scenario_manager = ScenarioManager()

fire_engine = None
decision_engine = None
active_scenario = None


def load_json_file(path: Path):

    if not path.exists():
        raise FileNotFoundError(
            f"No se encontró el archivo: {path}"
        )

    with path.open(
        "r",
        encoding="utf-8"
    ) as file:

        return json.load(file)


@app.get("/")
def root():

    return {
        "system": "EGS FIRE ACADEMY",
        "status": "online",
        "version": "0.3.0",
        "developer": "Téc. Ambiental Yamila Vocos",
        "location": "San Francisco, Córdoba, Argentina"
    }


# =========================================================
# DOCTRINA
# =========================================================

@app.get("/doctrine/structural-fire")
def structural_fire_doctrine():

    file_path = (
        KNOWLEDGE_DIR
        / "structural_fire_training.json"
    )

    return load_json_file(file_path)


@app.get("/doctrine/structural-fire/training")
def structural_fire_training():

    file_path = (
        KNOWLEDGE_DIR
        / "structural_fire_training.json"
    )

    data = load_json_file(file_path)

    return {
        "metadata": data["metadata"],
        "training": data["training"]
    }


@app.get("/doctrine/structural-fire/sections")
def structural_fire_sections():

    file_path = (
        KNOWLEDGE_DIR
        / "structural_fire_training.json"
    )

    data = load_json_file(file_path)

    return {
        "metadata": data["metadata"],
        "sections": data["sections"]
    }


# =========================================================
# ESCENARIOS
# =========================================================

@app.get("/scenarios")
def list_scenarios():

    return {
        "scenarios": scenario_manager.list()
    }


@app.post("/simulation/start/{scenario_filename}")
def start_simulation(
    scenario_filename: str
):

    global active_scenario
    global fire_engine
    global decision_engine

    active_scenario = (
        scenario_manager.load(
            scenario_filename
        )
    )

    fire_engine = FirePhysicsEngine()

    decision_engine = DecisionEngine()

    decision_engine.register_decision(
        "Inicio del entrenamiento"
    )

    return {
        "status": "simulation_started",
        "scenario": active_scenario,
        "fire": fire_engine.status(),
        "evaluation": (
            decision_engine.summary()
        )
    }


@app.post("/simulation/advance")
def advance_simulation():

    if fire_engine is None:

        return {
            "error":
            "No hay una simulación activa."
        }

    fire_engine.update()

    return {
        "fire": fire_engine.status(),
        "evaluation": (
            decision_engine.summary()
            if decision_engine
            else None
        )
    }


# =========================================================
# DECISIONES
# =========================================================

@app.post("/decision/{decision_type}")
def register_decision(
    decision_type: str
):

    if decision_engine is None:

        return {
            "error":
            "No hay una simulación activa."
        }


    if decision_type == "360":

        decision_engine.register_decision(
            "Reconocimiento exterior realizado"
        )


    elif decision_type == "entry":

        decision_engine.register_decision(
            "Ingreso antes de completar "
            "la evaluación exterior"
        )

        decision_engine.add_error(
            "Ingreso prematuro",
            20
        )


    elif decision_type == "ventilate":

        decision_engine.register_decision(
            "Ventilación ejecutada"
        )


    else:

        decision_engine.register_decision(
            f"Decisión registrada: "
            f"{decision_type}"
        )


    return (
        decision_engine.summary()
    )


# =========================================================
# INFORME
# =========================================================

@app.get("/simulation/report")
def simulation_report():

    if fire_engine is None:

        return {
            "error":
            "No hay una simulación activa."
        }


    return {
        "scenario": active_scenario,
        "fire": fire_engine.status(),
        "evaluation": (
            decision_engine.summary()
            if decision_engine
            else None
        )
    }


if __name__ == "__main__":

    import uvicorn

    uvicorn.run(
        "backend.api:app",
        host="127.0.0.1",
        port=8001,
        reload=True
    )