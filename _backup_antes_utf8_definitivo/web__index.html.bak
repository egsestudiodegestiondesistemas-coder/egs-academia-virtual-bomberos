<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#090b0e">
<title>EGS | Academia Virtual de Bomberos</title>
<link rel="stylesheet" href="styles.css?v=60">
</head>
<body>
<header class="topbar">
  <button class="brandButton" onclick="goHome()">
    <span class="brand">EGS | ACADEMIA VIRTUAL DE BOMBEROS</span>
    <span class="subtitle">FormaciÃ³n Â· EvaluaciÃ³n Â· SimulaciÃ³n operacional</span>
